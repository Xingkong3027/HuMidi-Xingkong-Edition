{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HuMidi Xingkong Edition",
  "version": "2.1.2-xk.14",
  "identifier": "com.xingkong.humidi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "HuMidi Xingkong",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 640,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
